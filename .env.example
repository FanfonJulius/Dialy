# Copy to .env and fill in. Only public values belong here (never a secret or service_role key).
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional: serve map tiles from elsewhere (e.g. http://localhost:8787 with `npm run tiles:serve`).
PUBLIC_TILES_BASE_URL=
