{
	"name": "daily",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
		"db:new": "supabase migration new",
		"db:push": "supabase db push"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.9",
		"@electric-sql/pglite-postgis": "^0.2.9",
		"@inlang/paraglide-js": "^2.27.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"supabase": "^2.120.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.4"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
